# Copy to .env for local runs. Do not commit .env.

# Bearer token for POST /calls and GET /calls. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_BEARER_TOKEN=

# Public https origin Twilio can reach. On Railway this is the generated domain.
# WebSocket media uses the same host with wss://.
PUBLIC_BASE_URL=https://your-service.up.railway.app

# Twilio API key (not the account auth token). The from-number is the Sydney caller ID.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=+61290904464
# Optional. Set this to require X-Twilio-Signature on webhooks.
TWILIO_AUTH_TOKEN=

# grok, openai, or gptlive. gptlive is off unless selected here.
VOICE_PROVIDER=grok

# Grok Voice (https://docs.x.ai/docs/guides/voice/agent)
XAI_API_KEY=
XAI_VOICE=eve
XAI_REALTIME_MODEL=grok-voice-latest
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_REASONING_EFFORT=none
# true speaks the compliance opener with xAI force_message
USE_FORCE_MESSAGE=true

# OpenAI Realtime, used when VOICE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VOICE=marin
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# GPT-Live, used when VOICE_PROVIDER=gptlive. Auth is OPENAI_API_KEY.
# Audio is audio/pcmu at 8000 Hz, the same μ-law Twilio already sends.
GPTLIVE_URL=wss://api.openai.com/v1/live/sessions
GPTLIVE_MODEL=gpt-live-1
GPTLIVE_VOICE=ripple
# Backend that calls end_call and record_opt_out. The delegation guide says
# gpt-6-luna; the WebSocket example uses gpt-5.6-luna.
GPTLIVE_RESPONSES_MODEL=gpt-6-luna

# Leave blank for SQLite at SQLITE_PATH. Railway Postgres URLs (postgres://...) are accepted.
DATABASE_URL=
SQLITE_PATH=data/calls.db
DO_NOT_CALL_PATH=data/do_not_call.txt
# Comma-separated numbers added to config/test_numbers.txt. Calling hours only.
TEST_NUMBERS=

DEFAULT_TIMEZONE=Australia/Sydney
PROMPT_PATH=prompts/system.txt
OPENER_PATH=prompts/compliance_opener.txt
INBOUND_PROMPT_PATH=prompts/inbound_system.txt
# Match an inbound caller to an outbound call from the last N days. 0 keeps all.
INBOUND_LOOKUP_DAYS=90

# Empty hangs up on an answering machine. Any text is spoken in Australian English, then the call ends.
MACHINE_MESSAGE=
AMD_HOLD_SECONDS=60
MACHINE_DETECTION_TIMEOUT=30
HANGUP_GRACE_SECONDS=8

LOG_LEVEL=INFO

# Optional. When unset, finished calls are not posted anywhere.
# TRANSCRIPT_WEBHOOK_AUTH_HEADER defaults to Authorization, which sends "Bearer <secret>".
# Any other header name sends the raw secret as the header value.
TRANSCRIPT_WEBHOOK_URL=
TRANSCRIPT_WEBHOOK_SECRET=
TRANSCRIPT_WEBHOOK_AUTH_HEADER=Authorization
