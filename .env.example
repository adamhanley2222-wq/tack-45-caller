# Copy to .env for local runs. Do not commit .env.

# Bearer token for POST /calls and GET /calls. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_BEARER_TOKEN=

# Public https origin Twilio can reach. On Railway this is the generated domain.
# WebSocket media uses the same host with wss://.
PUBLIC_BASE_URL=https://your-service.up.railway.app

# Twilio API key (not the account auth token). The from-number is the Sydney caller ID.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=+61290904464
# Optional. Set this to require X-Twilio-Signature on webhooks.
TWILIO_AUTH_TOKEN=

# grok, openai, gptlive, gemini, geminilive, or pipeline.
# gemini is Deepgram plus Gemini text plus Gemini TTS.
# geminilive is the Gemini Live websocket.
# pipeline is Cloud Speech-to-Text, a Gemini text model, and Cloud TTS.
# All three stay off unless selected here. The default remains grok.
VOICE_PROVIDER=grok

# Grok Voice (https://docs.x.ai/docs/guides/voice/agent)
XAI_API_KEY=
XAI_VOICE=eve
XAI_REALTIME_MODEL=grok-voice-latest
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_REASONING_EFFORT=none
# true speaks the compliance opener with xAI force_message
USE_FORCE_MESSAGE=true

# OpenAI Realtime, used when VOICE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VOICE=marin
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# GPT-Live, used when VOICE_PROVIDER=gptlive. Auth is OPENAI_API_KEY.
# Audio is audio/pcmu at 8000 Hz, the same μ-law Twilio already sends.
GPTLIVE_URL=wss://api.openai.com/v1/live/sessions
GPTLIVE_MODEL=gpt-live-1
GPTLIVE_VOICE=ripple
# Backend that calls end_call and record_opt_out. The delegation guide says
# gpt-6-luna; the WebSocket example uses gpt-5.6-luna.
GPTLIVE_RESPONSES_MODEL=gpt-6-luna

# Leave blank for SQLite at SQLITE_PATH. Railway Postgres URLs (postgres://...) are accepted.
DATABASE_URL=
SQLITE_PATH=data/calls.db
DO_NOT_CALL_PATH=data/do_not_call.txt
# Comma-separated numbers added to config/test_numbers.txt. Calling hours only.
TEST_NUMBERS=

DEFAULT_TIMEZONE=Australia/Sydney
PROMPT_PATH=prompts/system.txt
OPENER_PATH=prompts/compliance_opener.txt
# Outbound pipeline only. Hold "Hi, is this <name>?" until the person called
# speaks and then goes quiet, so the opener does not talk over their hello.
# The session is still opened immediately. false speaks as soon as the stream
# connects. Inbound calls do not wait. Other providers ignore these in this build.
OPENER_WAIT_FOR_SPEECH=true
OPENER_SILENCE_MS=500
OPENER_MAX_WAIT_MS=2500
INBOUND_PROMPT_PATH=prompts/inbound_system.txt
# Match an inbound caller to an outbound call from the last N days. 0 keeps all.
INBOUND_LOOKUP_DAYS=90

# Empty hangs up on an answering machine. Any text is spoken in Australian English, then the call ends.
MACHINE_MESSAGE=
AMD_HOLD_SECONDS=60
MACHINE_DETECTION_TIMEOUT=30
HANGUP_GRACE_SECONDS=8

LOG_LEVEL=INFO

# Gemini. Required for VOICE_PROVIDER=gemini (text model and TTS), VOICE_PROVIDER=geminilive,
# VOICE_PROVIDER=pipeline (text model only), and for POST /probe/tts.
# Cascade TTS on Tier 1 is 10 requests/minute and 100/day. Gemini Live on Tier 1 is not
# under that cap (unlimited requests, 150K tokens/minute). See the README.
GEMINI_API_KEY=
# Service-account JSON key, one line. Used by POST /probe/tts provider "cloudtts"
# and by VOICE_PROVIDER=pipeline (Speech-to-Text and StreamingSynthesize).
# The probe and the pipeline mint an OAuth token
# (scope https://www.googleapis.com/auth/cloud-platform) and do not log it.
# Enable speech.googleapis.com and texttospeech.googleapis.com, and grant the
# service account roles/speech.client. Chirp 3 HD rejects API keys.
GOOGLE_TTS_CREDENTIALS_JSON=
# Pipeline only, and only when GOOGLE_TTS_CREDENTIALS_JSON is empty.
GOOGLE_CLOUD_CREDENTIALS_JSON=
# Fallback only when GOOGLE_TTS_CREDENTIALS_JSON is empty. Sent as X-Goog-Api-Key
# by the probe. Chirp 3 HD returns 401 for an API key. The pipeline does not use it.
GOOGLE_TTS_API_KEY=
# VOICE_PROVIDER=pipeline. One streaming generateContent request per caller turn.
# Confirm this key's limits in AI Studio. A 429 ends the call.
PIPELINE_LLM_MODEL=gemini-2.5-flash
# 0 turns thinking off so gemini-2.5-flash speaks the first token immediately.
# A negative value omits thinkingConfig. This overrides GEMINI_THINKING_BUDGET.
PIPELINE_LLM_THINKING_BUDGET=0
PIPELINE_TTS_VOICE=en-AU-Chirp3-HD-Charon
PIPELINE_STT_MODEL=telephony
PIPELINE_STT_LANGUAGE=en-AU
PIPELINE_STT_LOCATION=global
# Silence before voice-activity end. The reply starts on that event.
PIPELINE_STT_ENDPOINT_MS=250
# Cascaded Gemini provider only. Ignored by grok, openai, gptlive, geminilive, and pipeline.
DEEPGRAM_API_KEY=
DEEPGRAM_URL=wss://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-AU
DEEPGRAM_ENDPOINTING_MS=400
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Charon
GEMINI_TTS_STYLE=Australian English accent, relaxed and friendly
GEMINI_TTS_LANGUAGE=en-AU
# 0 skips thinking when the text model accepts thinkingConfig. -1 omits the field.
GEMINI_THINKING_BUDGET=0

# Gemini Live, used when VOICE_PROVIDER=geminilive. Auth is GEMINI_API_KEY on the websocket URL.
# Model id is gemini-3.8-live (AI Studio: "Gemini 3.8 Live").
# The style string is a system instruction. It is not spoken aloud.
GEMINILIVE_MODEL=gemini-3.8-live
GEMINILIVE_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
GEMINILIVE_VOICE=Charon
GEMINILIVE_LANGUAGE=en-AU
GEMINILIVE_STYLE=Australian English accent, relaxed and friendly

# Optional. When unset, finished calls are not posted anywhere.
# TRANSCRIPT_WEBHOOK_AUTH_HEADER is the header name, or a full "Name: value" line.
# "Authorization" sends "Bearer <secret>". Any other name sends the raw secret.
# "Authorization: Bearer <token>" is parsed into that name and value.
TRANSCRIPT_WEBHOOK_URL=
TRANSCRIPT_WEBHOOK_SECRET=
TRANSCRIPT_WEBHOOK_AUTH_HEADER=Authorization
